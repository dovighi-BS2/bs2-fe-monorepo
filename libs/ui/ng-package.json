{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/ui",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    { "input": "src/lib/sass", "glob": "**/*.scss", "output": "styles" },
    { "input": "assets/icons", "glob": "**/*.svg", "output": "assets/icons" }
  ]
}
