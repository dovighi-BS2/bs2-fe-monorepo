    "@angular/forms": "^18.2.13",
    "@angular/material": "^18.2.14",
    "@angular/material-moment-adapter": "^18.2.14",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "@nx/angular": "21.0.3",
    "@nx/devkit": "21.0.3",
    "ngx-mask": "^14.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "~6.6.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "overrides": {
    "koa": "2.16.0"
  },
