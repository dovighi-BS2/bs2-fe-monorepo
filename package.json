{
  "name": "@bs2-fe-monorepo/source",
  "version": "0.0.0",
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "scripts": {
    "test:affected:develop": "nx affected -t test  --uncommited --base=origin/develop",
    "graph:affected": "nx graph --affected --base=origin/develop",
    "test:affected:main": "nx affected -t test",
    "create-entrypoint": "nx g bs2-entry-point",
    "package": "nx run-many -t build --projects=ui,compiled-plugins",
    "commit": "git-cz",
    "lint": "nx affected:lint --fix=true --uncommitted && nx test && nx format:write --uncommited",
    "prepare": "husky && git config --local core.editor cat"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.13",
